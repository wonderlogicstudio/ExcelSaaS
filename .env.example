# Web
VITE_PRODUCT_ENV=development
VITE_API_BASE_URL=http://localhost:8000
VITE_PRODUCT_NAME=WorkbookCare
VITE_ENABLE_REAL_UPLOAD=true
VITE_FORMULA_AUDIT_INTERNAL_BETA_ENABLED=false

# API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
MAX_UNCOMPRESSED_MB=120
MAX_ZIP_ENTRIES=5000
SCAN_CELL_LIMIT=250000
AI_EXPLANATIONS_ENABLED=false
FORMULA_PATTERN_AUDIT_ENABLED=false
FILE_RETENTION_HOURS=24

# Hosted Beta contract. Do not set these on a public or local server.
# APP_ENV=hosted_beta
# CORS_ORIGINS=https://beta.example.com
# The browser must call the same-origin Worker route (/api), never Cloud Run directly.
# VITE_API_BASE_URL=/api
# VITE_FORMULA_AUDIT_INTERNAL_BETA_ENABLED=false

# Production placeholders. Never commit real values.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DATABASE_URL=
OPENAI_API_KEY=
PAYMENT_SECRET=
# Future control-plane / provider secrets are configured in provider secret stores only.
CLOUDFLARE_API_TOKEN=
GOOGLE_CLOUD_PROJECT_ID=
WORKBOOKCARE_CONTROL_PLANE_HMAC_SECRET=
