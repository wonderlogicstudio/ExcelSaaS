{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbookcare-web",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "hosted_beta",
    "FORMULA_AUDIT_VISIBLE": "false"
  }
}
