{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbookcare-beta",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-09-09",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "workbookcare-beta-uploads"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FEEDBACK",
      "id": "1d24ab31eda24c38b9cc73dbb29e7bdf"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "926108451",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ENV": "hosted_beta",
    "MAX_UPLOAD_BYTES": "10485760",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://old-breeze-11c7.cloudflareaccess.com",
    "FEEDBACK_SCANNER_VERSION": "0.1.3",
    "FEEDBACK_FORMULA_AUDIT_RULE_SET_VERSION": "2026.09.5",
    "FEEDBACK_RELEASE_CANDIDATE_VERSION": "m4-formula-audit-rc1"
  }
}
