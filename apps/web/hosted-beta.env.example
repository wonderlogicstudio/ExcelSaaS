# Copy to apps/web/.env.hosted_beta only in a separately approved hosted-beta build.
# The browser calls the Cloudflare control plane on the same origin, not Cloud Run.
VITE_PRODUCT_ENV=hosted_beta
VITE_API_BASE_URL=/api
VITE_FEEDBACK_CAPTURE_ENABLED=false
VITE_FORMULA_AUDIT_INTERNAL_BETA_ENABLED=false
